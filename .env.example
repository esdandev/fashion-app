# Copiá este archivo a `.env` y completá los valores.
# El backend lee `.env` automáticamente al arrancar (sin pisar variables reales).

# Proveedor de IA: fake | gemini | opencode
AI__PROVIDER=fake

# Clave del proveedor. Obligatoria para gemini y opencode.
AI__APIKEY=

# Modelo. Si se deja vacío: gemini-3.8-flash (gemini) o gemini-4-argon (opencode).
AI__MODEL=

# Opcional: override del base URL del proveedor.
AI__BASEURL=

# Token de la instancia personal (obligatorio en Production si la demo está apagada).
APP__TOKEN=
